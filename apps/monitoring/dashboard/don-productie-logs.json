      },
      "pluginVersion": "12.1.0",
      "title": "",
      "transparent": true,
      "type": "text"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "don"
      },
      "description": "Aantal logregels met niveau error binnen de gekozen periode.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "don"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "sum(count_over_time({namespace=~\"$namespace\", app=~\"$app\"} | detected_level=\"error\" [$__range]))",
          "legendFormat": "Errors",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Errors",
      "type": "stat"
