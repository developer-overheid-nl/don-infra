      "targets": [{"editorMode": "code", "expr": "sum(increase(don_prod_pod_restarts_total{namespace=~\"$namespace\"}[24h])) or vector(0)", "instant": true, "legendFormat": "Herstarts", "range": false, "refId": "A"}],
