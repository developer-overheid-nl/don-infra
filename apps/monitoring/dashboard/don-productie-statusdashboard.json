  "panels": [
    {
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "content": "# DON Productie\nDit dashboard laat zien of de productieomgeving technisch gezond is. **Groen** is goed, **oranje** vraagt aandacht en **rood** betekent dat een pod niet gereed is of dat metingen ontbreken. Afgeronde nachtelijke taken tellen niet mee als actieve pods.",
        "mode": "markdown"
      },
      "title": "",
      "type": "text"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Groen vereist dat alle actieve pods gereed zijn en dat metingen voor alle gekozen onderdelen binnenkomen.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {
              "options": {
                "0": {"color": "red", "index": 0, "text": "Aandacht nodig"},
                "1": {"color": "green", "index": 1, "text": "Alles draait goed"}
              },
              "type": "value"
            }
          ],
          "noValue": "Geen metingen",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 3},
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "min(don_prod_metrics_collection_success{namespace=~\"$namespace\"}) * (sum(don_prod_pod_ready{namespace=~\"$namespace\"}) == bool sum(don_prod_pod_active{namespace=~\"$namespace\"}))",
          "instant": true,
          "legendFormat": "Status",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Systeemstatus",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Gereed is het aantal pods dat verkeer kan verwerken; actief omvat ook pods die nog starten of een probleem hebben.",
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "green", "mode": "fixed"},
          "decimals": 0,
          "mappings": [],
          "noValue": "Geen metingen",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 3},
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
