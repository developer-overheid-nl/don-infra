        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {"editorMode": "code", "expr": "sum(don_prod_pod_ready{namespace=~\"$namespace\"})", "instant": true, "legendFormat": "Gereed", "range": false, "refId": "A"},
        {"editorMode": "code", "expr": "sum(don_prod_pod_active{namespace=~\"$namespace\"})", "instant": true, "legendFormat": "Actief", "range": false, "refId": "B"}
