      "targets": [{"editorMode": "code", "expr": "100 * sum by (component) (don_prod_pod_ready{namespace=~\"$namespace\"}) / sum by (component) (don_prod_pod_active{namespace=~\"$namespace\"})", "instant": true, "legendFormat": "{{component}}", "range": false, "refId": "A"}],
